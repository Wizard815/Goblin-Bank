# Plaid credentials (shared by every worker). Copy the values into .secrets/plaid.env after running the setup script.
# Get keys at https://dashboard.plaid.com (Developers, Keys). Start with sandbox: fake banks, no real money.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox            # sandbox, then production once Plaid approves you
# Optional: a public HTTPS address for Plaid to call when new data is ready. Without it, syncs still run every 15 minutes.
# PLAID_WEBHOOK_URL=https://bank.example.com/webhooks/plaid
# Needed for banks that sign you in on their own website (many big banks, Capital One among them). Must be HTTPS, end with a slash,
# and be added exactly as written under Developers, API, Allowed redirect URIs in the Plaid dashboard. Use your app's address.
# PLAID_REDIRECT_URI=https://bank.example.com/
